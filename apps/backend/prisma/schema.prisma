generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  ASHA
  DOCTOR
  ADMIN
}

model User {
  id             String          @id @default(uuid())
  phoneNumber    String          @unique
  passwordHash   String
  role           Role            @default(PATIENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patientProfile PatientProfile?
  facilityId     String?
  facility       Facility?       @relation(fields: [facilityId], references: [id])
  healthVisits   HealthVisit[]   @relation("RecordedBy")
  syncReceipts   SyncReceipt[]
}
model Facility {
  id          String   @id @default(uuid())
  name        String
  type        String   // PHC, SUB_CENTRE, DISTRICT_HOSPITAL
  location    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  patients    PatientProfile[]
}

model PatientProfile {
  id          String   @id @default(uuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      String
  abhaId      String?  @unique
  
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  healthVisits HealthVisit[]
}

model SyncReceipt {
  id           String   @id @default(uuid())
  clientSyncId String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  operation    String
  entityType   String
  entityId     String?
  status       String
  processedAt  DateTime @default(now())
}

model HealthVisit {
  id           String         @id @default(uuid())
  patientId    String
  patient      PatientProfile @relation(fields: [patientId], references: [id])
  recordedById String
  recordedBy   User           @relation("RecordedBy", fields: [recordedById], references: [id])
  status       String
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  vitals       Vitals?
  symptoms     Symptom[]
}

model Vitals {
  id              String      @id @default(uuid())
  visitId         String      @unique
  visit           HealthVisit @relation(fields: [visitId], references: [id])
  temperature     Float?
  systolic        Int?
  diastolic       Int?
  heartRate       Int?
  spO2            Int?
  respiratoryRate Int?
  weight          Float?
}

model Symptom {
  id           String      @id @default(uuid())
  visitId      String
  visit        HealthVisit @relation(fields: [visitId], references: [id])
  name         String
  severity     String
  durationDays Int?
  notes        String?
}
